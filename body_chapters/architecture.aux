\@writefile{lof}{\contentsline {figure}{\numberline {4.3}{\ignorespaces Embedded vs.\ columnar property storage for Person vertices (EdgeKey). (a)~All properties packed into sentinel rows; every read fetches the full record. (b)~Sentinel rows store only degrees (8\,B); properties split into per-label column-group B-trees, so scanning one attribute reads only that group's pages.}}{18}{figure.caption.18}\protected@file@percent }
\newlabel{fig:schema:property}{{4.3}{18}{Embedded vs.\ columnar property storage for Person vertices (EdgeKey). (a)~All properties packed into sentinel rows; every read fetches the full record. (b)~Sentinel rows store only degrees (8\,B); properties split into per-label column-group B-trees, so scanning one attribute reads only that group's pages}{figure.caption.18}{}}
